{
  "name": "quodom-web-api",
  "version": "1.0.0",
  "description": "Quodom Web API - Express + Sequelize + SQLite (no vendors, no payments)",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node src/seed/seed.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seed.js",
    "reset-quodoms": "node src/seed/reset-quodoms.js",
    "guias": "node src/seed/guias.js",
    "import-images": "node src/seed/import-images.js",
    "report-missing-images": "node src/seed/report-missing-images.js",
    "add-image": "node src/seed/add-image.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-jwt": "^6.1.2",
    "express-openapi-validator": "^5.6.2",
    "helmet": "^4.6.0",
    "jsonwebtoken": "^8.5.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "rootpath": "^0.1.2",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ]
  }
}
